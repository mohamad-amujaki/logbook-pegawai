{
	"name": "logbook-api",
	"main": "src/worker.ts",
	"compatibility_date": "2026-09-28",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},
	"triggers": {
		"crons": ["0 17 * * *"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "logbook",
			"database_id": "cba214b4-169d-4c07-aa96-794dede7d222",
			"migrations_dir": "../../packages/db/migrations"
		}
	]
}
