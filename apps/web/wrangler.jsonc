{
	"name": "logbook-pegawai",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-09-28",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare",
		"html_handling": "none",
		"run_worker_first": ["/api/*"]
	},
	"observability": {
		"enabled": true
	},
	"services": [
		{
			"binding": "API",
			"service": "logbook-api"
		}
	]
}
