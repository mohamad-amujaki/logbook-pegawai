{
  "name": "logbook-pegawai",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter @logbook/api dev & bun run --filter @logbook/web dev",
    "dev:api": "bun run --filter @logbook/api dev",
    "dev:web": "bun run --filter @logbook/web dev",
    "db:migrate": "bun run --filter @logbook/db migrate",
    "db:seed": "bun run --filter @logbook/db seed",
    "db:seed:d1": "bun run --filter @logbook/db seed:d1",
    "deploy": "bun run --filter @logbook/api deploy && bun run --filter @logbook/web deploy",
    "test": "bun run --filter @logbook/schemas test",
    "check": "biome check .",
    "format": "biome check --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "husky": "^9.1.7"
  }
}
